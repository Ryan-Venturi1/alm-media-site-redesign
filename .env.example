# Public URL of the site (used for canonical links, sitemap and social cards)
NEXT_PUBLIC_SITE_URL=https://alotmedia.com

# Let search engines index the site. Leave unset on preview deployments.
ALLOW_INDEXING=

# --- Form delivery (any or all) -------------------------------------------
# POST every inquiry as JSON to a webhook (Slack incoming webhook, Zapier, Make, HubSpot…)
INQUIRY_WEBHOOK_URL=

# Email every inquiry with Resend (https://resend.com)
RESEND_API_KEY=
INQUIRY_EMAIL_TO=team@alotmedia.com
INQUIRY_EMAIL_FROM=A Lot Media website <web@alotmedia.com>
